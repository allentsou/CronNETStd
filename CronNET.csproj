<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0</TargetFrameworks>
    <Version>2.2026.0924.1</Version>
    <Description>輕量分鐘級 cron 排程器：Task + CancellationToken 協作式取消，精準對齊分鐘觸發。支援標準 5 欄 Cron 語法、防重疊執行與優雅關機收尾。</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>CronNETStd</PackageId>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cron;cron-expression;scheduler;job-scheduler;cron-parser;dotnet;csharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
